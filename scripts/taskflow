#!/bin/bash
# Runs TaskFlow on this Mac as a private local app: PostgreSQL + API + web, in Docker, with its own data and secrets.
# Everything the installed app owns lives in "$TASKFLOW_HOME" (default ~/Library/Application Support/TaskFlow), apart
# from the development stack in this repository, so a fresh database never touches development data.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_HOME="${TASKFLOW_HOME:-$HOME/Library/Application Support/TaskFlow}"
ENV_FILE="$DATA_HOME/.env"
BACKUPS="$DATA_HOME/backups"
# The installed app runs from a private copy of the sources. macOS does not let apps launched from Finder read
# ~/Documents (where a clone usually lives), so the copy sits in Application Support, which has no such restriction.
RUNTIME="$DATA_HOME/app"
SOURCE_FILE="$DATA_HOME/source-path"
LOG="$DATA_HOME/taskflow.log"
PROJECT="${TASKFLOW_PROJECT:-taskflow-app}"
KEEP_BACKUPS=20

# Once installed, the app's own copy is the single source of truth: commands run from a clone just hand over to it.
case "${1:-}" in
  start|stop|status|open|logs|backup|restore|reset)
    if [ "$ROOT" != "$RUNTIME" ] && [ -x "$RUNTIME/scripts/taskflow" ]; then
      exec "$RUNTIME/scripts/taskflow" "$@"
    fi
    ;;
esac

msg() { printf '%s\n' "$*"; }
die() { printf 'Lỗi: %s\n' "$*" >&2; exit 1; }

find_docker() {
  local candidate
  for candidate in "$(command -v docker 2>/dev/null || true)" \
    /Applications/Docker.app/Contents/Resources/bin/docker \
    "$HOME/Applications/Docker.app/Contents/Resources/bin/docker" \
    /opt/homebrew/bin/docker /usr/local/bin/docker; do
    # The CLI symlink can outlive a moved Docker.app, so check that it really runs.
    if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

DOCKER="$(find_docker)" || die "Không tìm thấy Docker. Cài Docker Desktop từ https://www.docker.com/products/docker-desktop/ rồi chạy lại."
export PATH="$(dirname "$DOCKER"):$PATH"

dc() { (cd "$ROOT" && "$DOCKER" compose -p "$PROJECT" --env-file "$ENV_FILE" -f "$ROOT/docker-compose.yml" "$@"); }

load_env() { set -a; . "$ENV_FILE"; set +a; }

url() { load_env; printf 'http://localhost:%s' "${WEB_PORT:-8765}"; }

# Secrets are generated once, on this machine, and never leave it (the file is private to the user).
cmd_init() {
  mkdir -p "$DATA_HOME" "$BACKUPS"
  chmod 700 "$DATA_HOME" "$BACKUPS"
  if [ -f "$ENV_FILE" ]; then
    return 0
  fi
  umask 077
  {
    echo "# Generated by 'taskflow init' on $(date '+%Y-%m-%d'). Keep this file private; do not commit or share it."
    echo "POSTGRES_DB=taskflow"
    echo "POSTGRES_USER=taskflow"
    echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
    echo "POSTGRES_PORT=5433"
    echo "WEB_PORT=8765"
    echo "Jwt__Key=$(openssl rand -base64 48 | tr -d '\n')"
    echo "Jwt__Issuer=TaskFlow"
    echo "Jwt__Audience=TaskFlow.Client"
    echo "Jwt__ExpiresMinutes=60"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  msg "Đã tạo cấu hình riêng (mật khẩu và khóa ngẫu nhiên): $ENV_FILE"
}

ensure_docker() {
  if "$DOCKER" info >/dev/null 2>&1; then
    return 0
  fi
  msg "Đang mở Docker Desktop..."
  open -ga Docker 2>/dev/null || open -ga "$HOME/Applications/Docker.app" 2>/dev/null || die "Không mở được Docker Desktop."
  local waited=0
  until "$DOCKER" info >/dev/null 2>&1; do
    sleep 3
    waited=$((waited + 3))
    [ "$waited" -lt 240 ] || die "Docker Desktop chưa sẵn sàng sau 4 phút."
  done
}

cmd_start() {
  cmd_init
  ensure_docker
  msg "Đang khởi động cơ sở dữ liệu..."
  dc up -d --wait postgres
  msg "Đang cập nhật cấu trúc dữ liệu (migration)..."
  dc --profile tools run --rm migrate
  msg "Đang dựng và chạy ứng dụng (lần đầu có thể mất vài phút)..."
  dc --profile app up -d --build --wait api web
  msg "TaskFlow đang chạy: $(url)"
}

cmd_stop() {
  ensure_docker
  [ -f "$ENV_FILE" ] || { msg "TaskFlow chưa được cài."; return 0; }
  dc --profile app --profile tools stop
  msg "Đã dừng TaskFlow. Dữ liệu vẫn được giữ."
}

cmd_status() {
  [ -f "$ENV_FILE" ] || { msg "TaskFlow chưa được cài (chạy: scripts/taskflow start)."; return 0; }
  if ! "$DOCKER" info >/dev/null 2>&1; then
    msg "Docker Desktop chưa chạy, nên TaskFlow đang dừng."
    return 0
  fi
  dc --profile app ps
  if curl -fsS -o /dev/null --max-time 3 "$(url)/"; then
    msg "Đang chạy: $(url)"
  else
    msg "Chưa chạy. Mở bằng: scripts/taskflow start"
  fi
}

# An app window, not a browser tab: the installed Chrome app if there is one, otherwise Chrome's own "app mode"
# (same page, but no tabs or address bar). Starting the Chrome binary hands the URL to a Chrome that is already running.
cmd_open() {
  load_env
  local pwa="$HOME/Applications/Chrome Apps.localized/TaskFlow.app"
  local chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  [ -x "$chrome" ] || chrome="$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  if [ -d "$pwa" ]; then
    open "$pwa"
  elif [ -x "$chrome" ]; then
    nohup "$chrome" --app="$(url)" --window-size=1280,860 >/dev/null 2>&1 &
    disown 2>/dev/null || true
  else
    open "$(url)"
    msg "Không thấy Google Chrome; đã mở bằng trình duyệt mặc định."
  fi
}

cmd_logs() { dc --profile app logs -f --tail 100 api web; }

cmd_backup() {
  cmd_init
  ensure_docker
  load_env
  local file="${1:-$BACKUPS/taskflow-$(date '+%Y%m%d-%H%M%S').sql.gz}"
  mkdir -p "$(dirname "$file")"
  # A dump holds every task and password hash: readable by this user only.
  umask 077
  dc exec -T postgres pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner | gzip > "$file"
  [ -s "$file" ] || die "Bản sao lưu rỗng, đã hủy."
  # Keep the newest few so backups never fill the disk unnoticed.
  ls -1t "$BACKUPS"/taskflow-*.sql.gz 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while IFS= read -r old; do rm -f "$old"; done
  msg "Đã sao lưu: $file"
}

cmd_restore() {
  local file="${1:-}" confirm="${2:-}"
  [ -n "$file" ] && [ -f "$file" ] || die "Dùng: taskflow restore <file.sql.gz> --yes"
  [ "$confirm" = "--yes" ] || die "Khôi phục sẽ GHI ĐÈ toàn bộ dữ liệu hiện tại. Thêm --yes để xác nhận."
  ensure_docker
  load_env
  dc up -d --wait postgres
  dc --profile app stop api web
  dc exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
  gunzip -c "$file" | dc exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -q
  cmd_start
}

# Copies what the containers are built from (not tests, docs or build output) into the app's private runtime folder.
cmd_sync() {
  command -v rsync >/dev/null || die "Thiếu rsync."
  local src="$ROOT"
  [ "$ROOT" != "$RUNTIME" ] || src="$(cat "$SOURCE_FILE" 2>/dev/null)" || true
  [ -f "$src/docker-compose.yml" ] || die "Không tìm thấy thư mục mã nguồn (đã ghi lúc cài: $SOURCE_FILE). Chạy 'scripts/taskflow install' từ thư mục clone."
  mkdir -p "$RUNTIME"
  rsync -a --delete \
    --exclude 'node_modules/' --exclude 'dist/' --exclude '.angular/' --exclude 'bin/' --exclude 'obj/' \
    --exclude 'TestResults/' --exclude '.git/' --exclude 'tests/' --exclude '.env' \
    "$src/docker-compose.yml" "$src/backend" "$src/frontend" "$src/scripts" "$RUNTIME/"
  chmod +x "$RUNTIME/scripts/taskflow"
}

cmd_update() {
  local src="$ROOT"
  [ "$ROOT" != "$RUNTIME" ] || src="$(cat "$SOURCE_FILE" 2>/dev/null)" || true
  if [ -d "$src/.git" ]; then
    (cd "$src" && git pull --ff-only)
  fi
  cmd_sync
  # A backup first, because the update may run migrations. It is skipped when the app is not running.
  "$RUNTIME/scripts/taskflow" backup 2>/dev/null || msg "(Bỏ qua sao lưu vì TaskFlow chưa chạy.)"
  exec "$RUNTIME/scripts/taskflow" start
}

cmd_reset() {
  [ "${1:-}" = "--yes" ] || die "Đặt lại sẽ XÓA toàn bộ dữ liệu TaskFlow đã cài. Thêm --yes để xác nhận (nên chạy 'taskflow backup' trước)."
  ensure_docker
  dc --profile app --profile tools down -v
  msg "Đã xóa dữ liệu. Lần start tiếp theo sẽ tạo cơ sở dữ liệu mới."
}

# --- the two Mac apps -------------------------------------------------------------------------------------------

make_app() { # name, script body
  local name="$1" body="$2" app="$HOME/Applications/$1.app"
  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$ROOT/scripts/mac/AppIcon.icns" "$app/Contents/Resources/AppIcon.icns"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>$name</string>
  <key>CFBundleDisplayName</key><string>$name</string>
  <key>CFBundleIdentifier</key><string>com.taskflow.local.$(printf '%s' "$name" | tr -cd 'A-Za-z')</string>
  <key>CFBundleExecutable</key><string>launcher</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
  printf '%s\n' "$body" > "$app/Contents/MacOS/launcher"
  chmod +x "$app/Contents/MacOS/launcher"
  touch "$app"
  msg "Đã tạo: $app"
}

cmd_install() {
  [ "$ROOT" != "$RUNTIME" ] || die "Chạy 'install' từ thư mục mã nguồn."
  cmd_init
  cmd_sync
  printf '%s' "$ROOT" > "$SOURCE_FILE"
  # A "taskflow" command that runs from the installed copy, so a terminal never has to read ~/Documents.
  mkdir -p "$HOME/.local/bin"
  ln -sf "$RUNTIME/scripts/taskflow" "$HOME/.local/bin/taskflow"
  mkdir -p "$HOME/Applications"
  local ctl="$RUNTIME/scripts/taskflow"
  make_app "TaskFlow" "#!/bin/bash
CTL=\"$ctl\"
LOG=\"$LOG\"
mkdir -p \"\$(dirname \"\$LOG\")\"
osascript -e 'display notification \"Đang khởi động, lần đầu có thể mất vài phút...\" with title \"TaskFlow\"' >/dev/null 2>&1
if \"\$CTL\" start >>\"\$LOG\" 2>&1; then
  \"\$CTL\" open >>\"\$LOG\" 2>&1
else
  osascript -e 'display dialog \"TaskFlow không khởi động được. Xem chi tiết trong tệp nhật ký.\" with title \"TaskFlow\" buttons {\"Mở nhật ký\", \"Đóng\"} default button \"Mở nhật ký\" with icon caution' 2>/dev/null | grep -q 'Mở nhật ký' && open -t \"\$LOG\"
  exit 1
fi"
  make_app "Dừng TaskFlow" "#!/bin/bash
CTL=\"$ctl\"
LOG=\"$LOG\"
mkdir -p \"\$(dirname \"\$LOG\")\"
if \"\$CTL\" stop >>\"\$LOG\" 2>&1; then
  osascript -e 'display notification \"Đã dừng. Dữ liệu vẫn được giữ.\" with title \"TaskFlow\"' >/dev/null 2>&1
else
  osascript -e 'display dialog \"Không dừng được TaskFlow. Xem nhật ký để biết lý do.\" with title \"TaskFlow\" buttons {\"Đóng\"} with icon caution' >/dev/null 2>&1
fi"
  msg ""
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) msg "Để gõ 'taskflow ...' ở mọi nơi, thêm vào ~/.zshrc: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;; esac
  msg "Xong. Bấm TaskFlow trong ~/Applications (hoặc Launchpad/Spotlight) để chạy."
  msg "TaskFlow mở thành cửa sổ ứng dụng riêng. (Tùy chọn: cài từ Chrome để có icon riêng trong Dock, xem README.)"
}

cmd_uninstall() {
  rm -rf "$HOME/Applications/TaskFlow.app" "$HOME/Applications/Dừng TaskFlow.app"
  [ "$(readlink "$HOME/.local/bin/taskflow" 2>/dev/null)" = "$RUNTIME/scripts/taskflow" ] && rm -f "$HOME/.local/bin/taskflow"
  msg "Đã gỡ hai ứng dụng khởi động. Dữ liệu và cấu hình vẫn ở: $DATA_HOME"
  msg "Muốn xóa cả dữ liệu: taskflow reset --yes, rồi xóa thư mục trên."
}

usage() {
  cat <<USAGE
TaskFlow trên Mac. Dùng: taskflow <lệnh>   (hoặc scripts/taskflow, hoặc đường dẫn đầy đủ nếu chưa có trong PATH)

  install     chép mã vào thư mục riêng của ứng dụng và tạo ứng dụng "TaskFlow" và "Dừng TaskFlow" trong ~/Applications
  uninstall   gỡ hai ứng dụng đó (giữ dữ liệu)
  start       bật Docker nếu cần, cập nhật cấu trúc dữ liệu, chạy TaskFlow
  stop        dừng TaskFlow (giữ dữ liệu)
  status      xem trạng thái
  open        mở TaskFlow thành cửa sổ ứng dụng (Chrome app mode, hoặc ứng dụng đã cài từ Chrome)
  logs        xem nhật ký của api và web
  backup [f]  sao lưu cơ sở dữ liệu ra file .sql.gz (mặc định: thư mục backups)
  restore f --yes  khôi phục từ bản sao lưu (ghi đè dữ liệu hiện tại)
  update      git pull, chép bản mới vào ứng dụng, sao lưu, dựng lại, chạy migration (chạy từ thư mục mã nguồn)
  reset --yes xóa toàn bộ dữ liệu đã cài

Dữ liệu và cấu hình: $DATA_HOME
USAGE
}

case "${1:-}" in
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  init) cmd_init ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  open) cmd_open ;;
  logs) cmd_logs ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  update) cmd_update ;;
  reset) shift; cmd_reset "$@" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
