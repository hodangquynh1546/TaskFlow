# Copy to .env and replace the placeholder values. NEVER commit .env.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Full stack in Docker (docker compose --profile app) ---
WEB_PORT=8080

# --- Backend (ASP.NET Core env-var form of configuration) ---
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=taskflow;Username=taskflow;Password=change-me"
# Generate with: openssl rand -base64 48   (must be >= 32 bytes)
Jwt__Key=replace-with-a-long-random-secret
Jwt__Issuer=TaskFlow
Jwt__Audience=TaskFlow.Client
Jwt__ExpiresMinutes=60
Jwt__RefreshDays=90
